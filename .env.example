# Copy this file to .env and fill in your local values. Never commit .env.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=housing_windsor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Superset metadata lives in its own database inside the same Postgres instance
SUPERSET_METADATA_DB=superset_meta
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(42))"
SUPERSET_SECRET_KEY=
# Signs embedded-dashboard guest tokens (etl/configs for the Embedded SDK
# spike -- see docs/embedding_spike.md). Generate the same way as
# SUPERSET_SECRET_KEY above; must be set before EMBEDDED_SUPERSET works.
GUEST_TOKEN_JWT_SECRET=
SUPERSET_ADMIN_USER=admin
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(12))"
SUPERSET_ADMIN_PASSWORD=
SUPERSET_PORT=8088

# Interface Docker publishes Postgres and Superset on. Keep 127.0.0.1 so
# neither is reachable from other machines (docs/production_hardening.md).
BIND_ADDRESS=127.0.0.1

# Website origin(s) allowed to embed Superset dashboards, comma-separated.
# Local: http://localhost:5173. Production: https://<SITE_DOMAIN>.
FRONTEND_ORIGINS=http://localhost:5173

# --- Production only (docker/docker-compose.prod.yml) ---
# Public domains for the website and Superset; both need a DNS A record
# pointing at the server. ACME_EMAIL receives Let's Encrypt expiry notices.
SITE_DOMAIN=
SUPERSET_DOMAIN=
ACME_EMAIL=
# Days of daily database backups to keep (docker/backup.sh).
BACKUP_RETENTION_DAYS=14

# Guest-token API (api/guest_token_server.py) -- optional, these are the defaults.
# SUPERSET_URL=http://localhost:8088
# GUEST_TOKEN_API_HOST=127.0.0.1
# GUEST_TOKEN_API_PORT=8090
