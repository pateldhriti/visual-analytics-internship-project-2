# Starts whva-backup.service every day at 03:30 (server time). Persistent:
# a run missed while the server was off happens at the next start.
[Unit]
Description=Daily backup of the warehouse schema of the whva database

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
