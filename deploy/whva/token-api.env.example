# Template for /etc/whva/token-api.env on whva (root-owned, chmod 600).
# Fill in on the server only; never commit the filled-in file.
SUPERSET_URL=https://apss.cs.uwindsor.ca
FRONTEND_ORIGINS=https://whva.cs.uwindsor.ca
GUEST_TOKEN_API_HOST=127.0.0.1
GUEST_TOKEN_API_PORT=8090
# The Superset account that requests guest tokens. On apss it needs the
# can_grant_guest_token permission, which only the admin can give.
# apss has no login form; it logs in through LDAP.
SUPERSET_LOGIN_PROVIDER=ldap
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
